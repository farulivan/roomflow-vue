{
  "name": "roomflow-vue",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vue-tsc -b && bunx --bun vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell --no-progress --gitignore \"src/**\" \"docs/**\" \".github/**\" \"*.{md,html,ts,js}\" package.json \"tsconfig*.json\" components.json wrangler.jsonc",
    "typecheck": "bunx --bun vue-tsc -b",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "preview": "bunx --bun vite preview",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/vue": "^1.72.0",
    "@tanstack/vue-query": "^5.107.1",
    "@unovis/ts": "^1.8.1",
    "@unovis/vue": "^1.8.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.10",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.5",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.161.0"
  }
}
